<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stripe Deep Navy Theme -->

    <!-- Core Backgrounds -->
    <SolidColorBrush x:Key="WindowBg" Color="#1c1e54"/>
    <SolidColorBrush x:Key="CardBg" Color="#22246A"/>
    <SolidColorBrush x:Key="CardBgHover" Color="#2A2C78"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#73FFFFFF"/>

    <!-- Accent Colors (Stripe Purple) -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#533afd"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="#4434d4"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#7c5cfc"/>

    <!-- Action Colors (Stripe Ruby) -->
    <SolidColorBrush x:Key="ActionRed" Color="#ea2261"/>
    <SolidColorBrush x:Key="ActionRedHover" Color="#d01e55"/>

    <!-- Status -->
    <SolidColorBrush x:Key="StatusIdle" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="StatusRunning" Color="#15be53"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderDefault" Color="#2A2C78"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#22246A"/>

    <!-- Error -->
    <SolidColorBrush x:Key="ErrorBg" Color="#2A101E"/>
    <SolidColorBrush x:Key="ErrorText" Color="#f87171"/>
    <SolidColorBrush x:Key="ErrorBorder" Color="#5c1a32"/>

    <!-- Typography -->
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Effects -->
    <DropShadowEffect x:Key="WindowShadow" Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.5"/>

</ResourceDictionary>
