<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Genshin-Inspired Glassmorphism Dark Theme (Deep) -->

    <!-- Core Backgrounds -->
    <SolidColorBrush x:Key="WindowBg" Color="#060A14"/>
    <SolidColorBrush x:Key="CardBg" Color="#0E1224"/>
    <SolidColorBrush x:Key="CardBgHover" Color="#141830"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8ECF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#7B8BA8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#4A5568"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="CyanGlow" Color="#00E5FF"/>
    <SolidColorBrush x:Key="EmeraldStart" Color="#00C9A7"/>
    <SolidColorBrush x:Key="EmeraldEnd" Color="#00E676"/>
    <SolidColorBrush x:Key="SapphireStart" Color="#2979FF"/>
    <SolidColorBrush x:Key="SapphireEnd" Color="#7C4DFF"/>
    <SolidColorBrush x:Key="DeepBlue" Color="#1A237E"/>
    <SolidColorBrush x:Key="ButtonStart" Color="#0D47A1"/>
    <SolidColorBrush x:Key="ButtonEnd" Color="#1565C0"/>

    <!-- Status -->
    <SolidColorBrush x:Key="StatusIdle" Color="#546E7A"/>
    <SolidColorBrush x:Key="StatusRunning" Color="#00E5FF"/>

    <!-- Border -->
    <SolidColorBrush x:Key="BorderGlow" Color="#1A3A6E"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1E2A4A"/>

    <!-- Error -->
    <SolidColorBrush x:Key="ErrorBg" Color="#1A0A1A"/>
    <SolidColorBrush x:Key="ErrorText" Color="#FF6B9D"/>
    <SolidColorBrush x:Key="ErrorBorder" Color="#4A1A3A"/>

    <!-- Typography -->
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
