<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AkiMacro</AssemblyName>
    <RootNamespace>AkiMacro</RootNamespace>
    <Authors>Akiro</Authors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico"/>
    <Resource Include="logo.png"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Compile Remove="DecompilerTool\**" />
    <Content Remove="DecompilerTool\**" />
    <EmbeddedResource Remove="DecompilerTool\**" />
    <None Remove="DecompilerTool\**" />
  </ItemGroup>
</Project>
