<Window x:Class="GenshinMacro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="320"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="#CC0A0E1A" CornerRadius="14" BorderBrush="#1A3A6E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0A0E1A" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right"
                        Width="24" Height="20"
                        CornerRadius="4"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseBtn_Click"
                        VerticalAlignment="Center">
                    <TextBlock Text="✕"
                               FontSize="11"
                               Foreground="#7B8BA8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <!-- Resolution -->
                <TextBlock Text="旋转宏分辨率"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           Margin="0,0,0,6"/>
                <Border Background="#12162A"
                        CornerRadius="8"
                        Padding="12,10"
                        BorderBrush="#1E2A4A"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1920 × 1080"
                                   FontSize="12"
                                   Foreground="#7B8BA8"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="默认"
                                   FontSize="10"
                                   Foreground="#4A5568"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Rotation Speed -->
                <TextBlock Text="轮询间隔"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           Margin="0,0,0,6"/>
                <Border Background="#12162A"
                        CornerRadius="8"
                        Padding="12,10"
                        BorderBrush="#1E2A4A"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="20ms (旋转) / 50ms (双玛头)"
                                   FontSize="12"
                                   Foreground="#7B8BA8"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="默认"
                                   FontSize="10"
                                   Foreground="#4A5568"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Auto Start -->
                <TextBlock Text="其他"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           Margin="0,0,0,6"/>
                <Border Background="#12162A"
                        CornerRadius="8"
                        Padding="12,10"
                        BorderBrush="#1E2A4A"
                        BorderThickness="1">
                    <TextBlock Text="启动时自动以管理员权限运行"
                               FontSize="12"
                               Foreground="#7B8BA8"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="2"
                    Content="完成"
                    Click="CloseBtn_Click"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="0,10"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="0,10"
                                BorderBrush="#1A3A6E"
                                BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                    <GradientStop Color="#1565C0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2979FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
