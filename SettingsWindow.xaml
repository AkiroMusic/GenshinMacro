<Window x:Class="GenshinMacro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="320"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamily}">

    <Border Background="{StaticResource WindowBg}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right"
                        Width="24" Height="20"
                        CornerRadius="4"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseButton_Click"
                        VerticalAlignment="Center">
                    <TextBlock Text="✕"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <!-- Resolution -->
                <TextBlock Text="旋转宏分辨率"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="4"
                        Padding="12,10"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1920 × 1080"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="默认"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Poll Interval -->
                <TextBlock Text="轮询间隔"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="4"
                        Padding="12,10"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="20ms (旋转) / 50ms (双玛头)"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="默认"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Auto Start -->
                <TextBlock Text="其他"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="4"
                        Padding="12,10"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1">
                    <TextBlock Text="启动时自动以管理员权限运行"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="2"
                    Content="完成"
                    Click="CloseBtn_Click"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="0,10"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand"
                    Foreground="#FFFFFF">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Padding="0,10"
                                Background="{StaticResource AccentPrimary}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
