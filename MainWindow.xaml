<Window x:Class="AkiMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AkiMacro.ViewModels"
        mc:Ignorable="d"
        Title="AkiMacro"
        Width="380"
        Height="440"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamily}">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <!-- Main chrome: Stripe Brand Dark background -->
    <Border Background="{StaticResource WindowBg}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Subtle purple ambient glow (bottom-right) -->
            <Ellipse Width="260" Height="260"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-50,-50"
                     Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40533afd" Offset="0"/>
                        <GradientStop Color="#20533afd" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main content -->
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Bar (draggable) -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/logo.png"
                               Width="18" Height="18"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AkiMacro"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Minimize -->
                        <Border Width="28" Height="20"
                                CornerRadius="4"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonDown="MinimizeBtn_Click">
                            <TextBlock Text="─"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Close -->
                        <Border Width="28" Height="20"
                                CornerRadius="4"
                                Background="Transparent"
                                Cursor="Hand"
                                Margin="4,0,0,0"
                                MouseLeftButtonDown="CloseBtn_Click">
                            <TextBlock Text="✕"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Status Indicator (minimal: dot + label, no glow) -->
                <Border Grid.Row="1"
                        HorizontalAlignment="Center"
                        CornerRadius="4"
                        Padding="12,5"
                        Margin="0,8,0,16"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusIdle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="已停止"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="运行中"/>
                                            <Setter Property="Foreground" Value="{StaticResource StatusRunning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Feature Cards -->
                <StackPanel Grid.Row="2">

                    <!-- Card 1: Side Button 1 -->
                    <Border CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Background="{StaticResource CardBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="侧键1"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="自动旋转"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentPrimary}">
                                <TextBlock Text="X1"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2: Side Button 2 -->
                    <Border CornerRadius="6"
                            Padding="16,14"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Background="{StaticResource CardBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="侧键2"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="双键宏"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentSecondary}">
                                <TextBlock Text="X2"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 3: Clicker (独立功能) -->
                    <Border CornerRadius="6"
                            Padding="16,14"
                            Margin="0,8,0,0"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Background="{StaticResource CardBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="鼠标连点器"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="F9启动 F10停止 F11切换"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource StatusRunning}">
                                <TextBlock Text="F9/F10/F11"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Clicker Status & Controls -->
                <Border Grid.Row="3" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                        BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                        Background="{StaticResource CardBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Clicker Status Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdle}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClickerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusRunning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="连点器: 就绪"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClickerRunning}" Value="True">
                                                <Setter Property="Text" Value="连点器: 运行中"/>
                                                <Setter Property="Foreground" Value="{StaticResource StatusRunning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Click Counter -->
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Run Text="已点击: "/>
                            <Run Text="{Binding ClicksPerformed}"/>
                        </TextBlock>
                        
                        <!-- Toggle Clicker Button -->
                        <Button Grid.Column="2" Command="{Binding ToggleClickerCommand}"
                                FontSize="11" FontWeight="SemiBold" Padding="12,6"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource AccentPrimary}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        Background="Transparent" BorderThickness="1"
                                                        BorderBrush="{StaticResource AccentPrimary}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      TextElement.Foreground="{StaticResource AccentPrimary}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource AccentPrimary}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource AccentPrimary}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClickerRunning}" Value="False">
                                            <Setter Property="Content" Value="启动连点器"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsClickerRunning}" Value="True">
                                            <Setter Property="Content" Value="停止连点器"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border Grid.Row="4" CornerRadius="4" Padding="12,8" Margin="0,12,0,0"
                        BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1"
                        Background="{StaticResource ErrorBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource ErrorText}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding DismissErrorCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource ErrorText}" FontSize="12"
                                Padding="4,0" Margin="8,0,0,0"
                                Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Bottom Links -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <TextBlock Text="Settings"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Cursor="Hand"
                               MouseLeftButtonDown="Settings_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="·"
                               FontSize="11"
                               Foreground="{StaticResource BorderDefault}"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="About"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Cursor="Hand"
                               MouseLeftButtonDown="About_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Toggle Button (Start/Stop) -->
                <Button Grid.Row="6"
                        Command="{Binding ToggleCommand}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="0,12"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- Default: Start (Purple) -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0"
                                                Background="{StaticResource AccentPrimary}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#533afd" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="#FFFFFF"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentPrimaryHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- Running state text -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Content" Value="启 动"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="停 止"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="4"
                                                        Padding="0,12"
                                                        BorderThickness="0"
                                                        Background="{StaticResource ActionRed}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#ea2261" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="#FFFFFF"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource ActionRedHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Copyright -->
                <TextBlock Grid.Row="7"
                           Text="© 2026 Akiro. All rights reserved."
                           FontSize="10"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
