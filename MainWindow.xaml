<Window x:Class="GenshinMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GenshinMacro.ViewModels"
        mc:Ignorable="d"
        Title="Genshin Macro"
        Width="380"
        Height="440"
        Icon="/app.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamily}">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.8" Duration="0:0:1.5"/>
        </Storyboard>
        <Storyboard x:Key="AuroraAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AuroraEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.35" Duration="0:0:3"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
            <BeginStoryboard Storyboard="{StaticResource AuroraAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#E6060A14" CornerRadius="14" BorderBrush="#1A3A6E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0A0E1A" BlurRadius="32" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <!-- Aurora glow -->
            <Ellipse x:Name="AuroraEllipse"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Width="300" Height="300"
                     Margin="0,0,-80,-80"
                     Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4000E5FF" Offset="0"/>
                        <GradientStop Color="#202979FF" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main content -->
            <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/logo.png"
                               Width="16" Height="16"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Genshin Macro"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E8ECF4"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Width="28" Height="20"
                                CornerRadius="4"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonDown="MinimizeBtn_Click">
                            <TextBlock Text="─"
                                       FontSize="11"
                                       Foreground="#7B8BA8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="28" Height="20"
                                CornerRadius="4"
                                Background="Transparent"
                                Cursor="Hand"
                                Margin="4,0,0,0"
                                MouseLeftButtonDown="CloseBtn_Click">
                            <TextBlock Text="✕"
                                       FontSize="11"
                                       Foreground="#7B8BA8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Status Indicator -->
                <Border Grid.Row="1"
                        HorizontalAlignment="Center"
                        CornerRadius="999"
                        Padding="16,6"
                        Margin="0,10,0,14"
                        Background="#0E1224"
                        BorderBrush="#1E2A4A"
                        BorderThickness="1">
                    <Grid>
                        <Border x:Name="StatusGlow"
                                CornerRadius="999"
                                Opacity="0.4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="-4">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#4000E5FF" Offset="0"/>
                                    <GradientStop Color="#0000E5FF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#546E7A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="#00E5FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="已停止"/>
                                        <Setter Property="Foreground" Value="#546E7A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="运行中"/>
                                                <Setter Property="Foreground" Value="#00E5FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cards -->
                <StackPanel Grid.Row="2" Margin="0,0,0,0">

                    <!-- Card 1 -->
                    <Border CornerRadius="12"
                            Padding="16,14"
                            Margin="0,0,0,8"
                            BorderBrush="#1E2A4A"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#141830" Offset="0"/>
                                <GradientStop Color="#0C1020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="侧键1"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E8ECF4"/>
                                <TextBlock Text="龙王自动旋转"
                                           FontSize="11"
                                           Foreground="#00B8D4"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    VerticalAlignment="Center"
                                    BorderBrush="#10B981"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00C9A7" Offset="0"/>
                                        <GradientStop Color="#00E676" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="X1"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#0A0E1A"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border CornerRadius="12"
                            Padding="16,14"
                            Margin="0,0,0,0"
                            BorderBrush="#1E2A4A"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#141830" Offset="0"/>
                                <GradientStop Color="#0C1020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="侧键2"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E8ECF4"/>
                                <TextBlock Text="双玛头宏"
                                           FontSize="11"
                                           Foreground="#7C8CF4"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    VerticalAlignment="Center"
                                    BorderBrush="#2979FF"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2979FF" Offset="0"/>
                                        <GradientStop Color="#7C4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="X2"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Error Banner -->
                <Border Grid.Row="3" CornerRadius="10" Padding="12,8" Margin="0,10,0,0"
                        BorderBrush="#4A1A3A" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A0A1A"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="#FF6B9D" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding DismissErrorCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6B9D" FontSize="12"
                                Padding="4,0" Margin="8,0,0,0"
                                Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Bottom Links -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="Settings"
                               FontSize="11"
                               Foreground="#546E7A"
                               Cursor="Hand"
                               MouseLeftButtonDown="Settings_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#546E7A"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#7B8BA8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="·"
                               FontSize="11"
                               Foreground="#2A3444"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="About"
                               FontSize="11"
                               Foreground="#546E7A"
                               Cursor="Hand"
                               MouseLeftButtonDown="About_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#546E7A"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#7B8BA8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Toggle Button -->
                <Button Grid.Row="5"
                        Command="{Binding ToggleCommand}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="0,12"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}"
                                                BorderBrush="#1A3A6E"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0D47A1" Offset="0"/>
                                                    <GradientStop Color="#1565C0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#1A237E" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2979FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Content" Value="启 动"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="停 止"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="10"
                                                        Padding="0,12"
                                                        BorderBrush="#4A1A3A"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#4A1A3A" Offset="0"/>
                                                            <GradientStop Color="#6A1A4A" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FF6B9D" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6B9D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
