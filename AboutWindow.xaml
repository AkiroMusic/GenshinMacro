<Window x:Class="GenshinMacro.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="320"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="#CC0A0E1A" CornerRadius="14" BorderBrush="#1A3A6E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0A0E1A" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="About"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right"
                        Width="24" Height="20"
                        CornerRadius="4"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseBtn_Click"
                        VerticalAlignment="Center">
                    <TextBlock Text="✕"
                               FontSize="11"
                               Foreground="#7B8BA8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- About Content -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                <!-- App Icon -->
                <Border Width="56" Height="56"
                        CornerRadius="14"
                        BorderBrush="#1A3A6E"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#181D35" Offset="0"/>
                            <GradientStop Color="#0D47A1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="/logo.png"
                           Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="Genshin Macro"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#E8ECF4"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="版本 1.1.1"
                           FontSize="11"
                           Foreground="#7B8BA8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="作者：Akiro"
                           FontSize="11"
                           Foreground="#7B8BA8"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
                <TextBlock Text="原神鼠标宏工具"
                           FontSize="11"
                           Foreground="#4A5568"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="2"
                    Content="关闭"
                    Click="CloseBtn_Click"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="0,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="0,10"
                                BorderBrush="#1E2A4A"
                                BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#12162A" Offset="0"/>
                                    <GradientStop Color="#181D35" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2979FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
