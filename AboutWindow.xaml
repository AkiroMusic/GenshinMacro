<Window x:Class="AkiMacro.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="320"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamily}">

    <Border Background="{StaticResource WindowBg}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderDefault}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="About"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right"
                        Width="24" Height="20"
                        CornerRadius="4"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonDown="CloseButton_Click"
                        VerticalAlignment="Center">
                    <TextBlock Text="✕"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- About Content -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                <!-- App Icon -->
                <Border Width="52" Height="52"
                        CornerRadius="8"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Image Source="/logo.png"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="AkiMacro"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="版本 1.4.0"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="作者：Akiro"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
                <TextBlock Text="通用鼠标宏工具"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="2"
                    Content="关闭"
                    Click="CloseBtn_Click"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Padding="0,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    Cursor="Hand"
                    Foreground="#FFFFFF">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Padding="0,10"
                                Background="{StaticResource AccentPrimary}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
